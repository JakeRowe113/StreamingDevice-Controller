<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Viewer</title>
    
    <!-- Simple Keyboard CSS and JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-keyboard@latest/build/css/index.css">
    <script src="https://cdn.jsdelivr.net/npm/simple-keyboard@latest/build/index.js"></script>

    <script>
        (function() {
            const savedScale = localStorage.getItem('system_display_scale');
            if (savedScale) {
                const factor = parseFloat(savedScale) / 100;
                try {
                    const { webFrame } = require('electron');
                    webFrame.setZoomFactor(factor);
                } catch(e) {
                    document.documentElement.style.zoom = factor;
                }
            }
        })();
    </script>
    <style>
        :root {
            --bg-color: #000000;
            --panel-bg: rgba(20, 20, 20, 0.85);
            --panel-active: #2a2a2a;
            --text-color: #ffffff;
            --accent-color: #ffd700;
        }

        body, html {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        webview {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
            background-color: #ffffff;
            z-index: 1;
        }

        .flyout-wrapper {
            position: fixed;
            top: 50%;
            left: 32px; 
            transform: translateY(-50%); 
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: var(--panel-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid #333;
            border-radius: 32px;
            padding: 4px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
            width: 56px; 
            height: auto; /* Changed to auto so it fits the permanent items */
            box-sizing: border-box;
        }

        .flyout-wrapper.dragging {
            transition: none !important; 
        }

        .menu-items {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            opacity: 1; /* Always fully visible */
            margin-top: 4px;
            margin-left: 0;
            pointer-events: auto; /* Always interactive */
            white-space: nowrap;
        }

        .nav-btn {
            background-color: transparent;
            border-radius: 50%;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border: none;
            cursor: pointer;
            flex-shrink: 0;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .nav-btn:hover {
            background-color: var(--panel-active);
        }

        .nav-btn:active {
            transform: scale(0.9);
        }

        .nav-btn svg {
            width: 24px;
            height: 24px;
            stroke: var(--text-color);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: stroke 0.2s ease;
        }

        .nav-btn:hover svg {
            stroke: var(--accent-color);
        }

        .drag-handle { cursor: grab; }
        .drag-handle:active { cursor: grabbing; }

        #toast {
            position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%) translateY(100px);
            background: var(--accent-color); color: #000; padding: 12px 24px; border-radius: 30px;
            font-weight: bold; box-shadow: 0 10px 30px rgba(0,0,0,0.5); opacity: 0;
            transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: 10000; pointer-events: none;
        }
        #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

        /* Keyboard Overlay Styles */
        #keyboard-wrapper {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: rgba(20, 20, 20, 0.95);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            padding: 20px;
            box-sizing: border-box;
            border-top: 2px solid var(--accent-color);
            z-index: 10000;
            display: none;
            box-shadow: 0 -10px 40px rgba(0,0,0,0.8);
        }
        .tv-theme {
            background-color: transparent !important;
            max-width: 1000px;
            margin: 0 auto;
        }
        .tv-theme .hg-button {
            background: #2a2a2a;
            color: #ffffff;
            border-bottom: 1px solid #111;
            height: 55px;
            font-size: 1.2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.4);
        }
        .tv-theme .hg-button:active, 
        .tv-theme .hg-button.hg-activeButton {
            background: var(--accent-color);
            color: #000;
        }
    </style>
</head>
<body>

    <webview id="viewer-frame" allowpopups></webview>

    <div id="toast">Sent to TV</div>

    <div class="flyout-wrapper" id="flyoutMenu">
        <!-- Menu Items (Always Visible) -->
        <div class="menu-items">
            <!-- Drag Handle -->
            <div class="nav-btn drag-handle" title="Drag to move" onmousedown="startDrag(event)">
                <svg viewBox="0 0 24 24">
                    <line x1="8" y1="10" x2="16" y2="10" stroke-width="2" stroke-linecap="round"></line>
                    <line x1="8" y1="14" x2="16" y2="14" stroke-width="2" stroke-linecap="round"></line>
                </svg>
            </div>

            <!-- Home -->
            <a href="index.html" class="nav-btn" title="Home" onclick="event.stopPropagation();">
                <svg viewBox="0 0 24 24">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
            </a>

            <!-- Back -->
            <button onclick="event.stopPropagation(); window.history.back()" class="nav-btn" title="Go Back">
                <svg viewBox="0 0 24 24">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </button>

            <!-- Forward -->
            <button onclick="event.stopPropagation(); window.history.forward()" class="nav-btn" title="Go Forward">
                <svg viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>

            <!-- Refresh -->
            <button onclick="event.stopPropagation(); refreshFrame()" class="nav-btn" title="Refresh">
                <svg viewBox="0 0 24 24">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
            </button>

            <!-- Keyboard Toggle -->
            <button onclick="event.stopPropagation(); toggleKeyboard()" class="nav-btn" title="On-Screen Keyboard">
                <svg viewBox="0 0 24 24" style="stroke-width: 1.5;">
                    <rect x="2" y="6" width="20" height="12" rx="2" ry="2"></rect>
                    <line x1="6" y1="10" x2="6.01" y2="10"></line>
                    <line x1="10" y1="10" x2="10.01" y2="10"></line>
                    <line x1="14" y1="10" x2="14.01" y2="10"></line>
                    <line x1="18" y1="10" x2="18.01" y2="10"></line>
                    <line x1="6" y1="14" x2="6.01" y2="14"></line>
                    <line x1="18" y1="14" x2="18.01" y2="14"></line>
                    <line x1="10" y1="14" x2="14" y2="14"></line>
                </svg>
            </button>
            
            <!-- Play on TV -->
            <button onclick="event.stopPropagation(); sendToTv()" class="nav-btn" title="Play on TV">
                <svg viewBox="0 0 24 24">
                    <path d="M2 16.1A5 5 0 0 1 5.9 20M2 12.05A9 9 0 0 1 9.95 20M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"></path>
                    <circle cx="2" cy="20" r="1.5" fill="var(--text-color)" stroke="none"></circle>
                </svg>
            </button>
        </div>
    </div>

    <!-- On-Screen Keyboard Container -->
    <div id="keyboard-wrapper">
        <div class="simple-keyboard"></div>
    </div>

    <script>
        const CONFIG = {
            targetDeviceIp: 'http://10.2.0.50:3000'
        };

        const urlParams = new URLSearchParams(window.location.search);
        const targetUrl = urlParams.get('url');
        const isTv = urlParams.get('ua') === 'tv';
        const viewer = document.getElementById('viewer-frame');
        const flyout = document.getElementById('flyoutMenu');

        if (isTv) {
            viewer.setAttribute('useragent', 'Mozilla/5.0 (SMART-TV; Linux; Tizen 5.0) AppleWebKit/538.1 (KHTML, like Gecko) Version/5.0 NativeTV/5.0 Safari/538.1');
        }

        if (targetUrl) {
            viewer.src = targetUrl;
        }

        function refreshFrame() {
            viewer.reload();
        }

        // --- Toast Notification Logic ---
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.innerText = message;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // --- Play on TV Logic ---
        function sendToTv() {
            const currentUrl = viewer.src;
            if (!currentUrl) return;

            const apiUrl = `${CONFIG.targetDeviceIp}/play?url=${encodeURIComponent(currentUrl)}`;
            
            fetch(apiUrl)
                .then(res => res.json())
                .then(data => {
                    showToast('Sent to TV!');
                })
                .catch(err => {
                    console.error(err);
                    alert('Failed to connect to the TV at ' + CONFIG.targetDeviceIp);
                });
        }

        // --- Virtual Keyboard Logic ---
        let keyboard;
        let isKeyboardVisible = false;

        document.addEventListener('DOMContentLoaded', () => {
            const Keyboard = window.SimpleKeyboard.default;
            keyboard = new Keyboard({
                onKeyPress: button => handleKeyPress(button),
                theme: "hg-theme-default hg-layout-default tv-theme",
                layout: {
                    default: [
                        "1 2 3 4 5 6 7 8 9 0 - = {bksp}",
                        "q w e r t y u i o p [ ] \\",
                        "a s d f g h j k l ; ' {enter}",
                        "{shift} z x c v b n m , . /",
                        "{space}"
                    ],
                    shift: [
                        "! @ # $ % ^ & * ( ) _ + {bksp}",
                        "Q W E R T Y U I O P { } |",
                        "A S D F G H J K L : \" {enter}",
                        "{shift} Z X C V B N M < > ?",
                        "{space}"
                    ]
                },
                display: {
                    '{bksp}': '⌫',
                    '{enter}': '↵ Enter',
                    '{shift}': '⇧',
                    '{space}': 'Space'
                }
            });
        });

        function toggleKeyboard() {
            const wrapper = document.getElementById('keyboard-wrapper');
            isKeyboardVisible = !isKeyboardVisible;
            wrapper.style.display = isKeyboardVisible ? 'block' : 'none';
        }

        function handleKeyPress(button) {
            if (button === "{shift}") {
                let currentLayout = keyboard.options.layoutName;
                let shiftToggle = currentLayout === "default" ? "shift" : "default";
                keyboard.setOptions({ layoutName: shiftToggle });
                return;
            }

            if (button === "{enter}") {
                viewer.sendInputEvent({ type: 'keyDown', keyCode: 'Enter' });
                viewer.sendInputEvent({ type: 'keyUp', keyCode: 'Enter' });
                toggleKeyboard();
                return;
            }

            let charStr = button;
            let keyCode = button;

            if (button === "{bksp}") {
                keyCode = 'Backspace';
                charStr = undefined;
            } else if (button === "{space}") {
                keyCode = 'Space';
                charStr = ' ';
            }

            if (keyCode === 'Backspace' || keyCode === 'Space') {
                 viewer.sendInputEvent({ type: 'keyDown', keyCode: keyCode });
                 viewer.sendInputEvent({ type: 'keyUp', keyCode: keyCode });
            } else {
                 viewer.sendInputEvent({ type: 'char', keyCode: charStr });
            }
        }

        // --- Drag Logic ---
        let isDragging = false;
        let startY = 0;
        let startTop = 0;

        function startDrag(e) {
            e.preventDefault();
            e.stopPropagation();
            isDragging = true;
            flyout.classList.add('dragging');
            
            const rect = flyout.getBoundingClientRect();
            startTop = rect.top + (rect.height / 2);
            startY = e.clientY;

            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', stopDrag);
        }

        function onDrag(e) {
            if (!isDragging) return;
            e.preventDefault();
            
            let dy = e.clientY - startY;
            let newTop = startTop + dy;
            
            const halfHeight = flyout.offsetHeight / 2;
            if (newTop < halfHeight) newTop = halfHeight;
            if (newTop > window.innerHeight - halfHeight) newTop = window.innerHeight - halfHeight;
            
            flyout.style.top = newTop + 'px';
        }

        function stopDrag(e) {
            isDragging = false;
            flyout.classList.remove('dragging');
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', stopDrag);
        }
    </script>
</body>
</html>
